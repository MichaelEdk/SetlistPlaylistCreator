<Window x:Class="SetlistPlaylistCreator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:artistSearch="clr-namespace:SetlistPlaylistCreator.Wpf.ArtistSearch"
        xmlns:authorization="clr-namespace:SetlistPlaylistCreator.Wpf.Authorization"
        xmlns:songList="clr-namespace:SetlistPlaylistCreator.Wpf.SongList"
        xmlns:playlist="clr-namespace:SetlistPlaylistCreator.Wpf.Playlist"
        xmlns:complete="clr-namespace:SetlistPlaylistCreator.Wpf.Complete"
        xmlns:local="clr-namespace:SetlistPlaylistCreator.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate x:Name="ArtistSearchView" DataType="{x:Type artistSearch:ArtistSearchViewModel}">
            <artistSearch:ArtistSearchView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Name="AuthorizationView" DataType="{x:Type authorization:AuthorizationViewModel}">
            <authorization:AuthorizationUserControl DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Name="SongListView" DataType="{x:Type songList:SongListViewModel}">
            <songList:SongListView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Name="PlaylistView" DataType="{x:Type playlist:PlaylistViewModel}">
            <playlist:Playlist DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Name="CompleteView" DataType="{x:Type complete:CompleteViewModel}">
            <complete:CompleteView DataContext="{Binding}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" 
                Content="← Back" 
                Command="{Binding BackCommand}"
                IsEnabled="{Binding CanNavigateBack}"
                HorizontalAlignment="Left"
                Margin="10"
                Padding="10,5"/>

        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
