<UserControl x:Class="SetlistPlaylistCreator.Wpf.Authorization.AuthorizationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SetlistPlaylistCreator.Wpf.Authorization"
             xmlns:windows="clr-namespace:SetlistPlaylistCreator.Wpf.Windows"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:AuthorizationViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <windows:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Reusable primary button style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="AntiqueWhite"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F3F3">
        <Border CornerRadius="8"
            Background="White"
            Padding="24"
            Margin="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <!-- Explicit DropShadowEffect -->
            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    BlurRadius="10"
                    ShadowDepth="2"
                    Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Instruction Text -->
                <TextBlock Grid.Row="0"
                   Text="To get started, log in with your Spotify account."
                   TextWrapping="Wrap"
                   FontSize="16"
                   Margin="0,0,0,16"/>

                <!-- Initialize Button -->
                <Button Grid.Row="1"
                Content="Initialize Authorization"
                Command="{Binding InitializeCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="0,0,0,16"/>

                <!-- Authorization Hyperlink -->
                <TextBlock Grid.Row="2"
                   Visibility="{Binding AuthorizationCodeUrl, Converter={StaticResource NullToVisibilityConverter}}"
                   FontSize="14"
                   Margin="0,0,0,16">
          <Hyperlink NavigateUri="{Binding AuthorizationCodeUrl, UpdateSourceTrigger=PropertyChanged}"
                     RequestNavigate="Hyperlink_RequestNavigate">
            Click here to authorize on Spotify
          </Hyperlink>
                </TextBlock>

                <!-- Token Input and Submit -->
                <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,0">

                    <TextBox Width="300"
                   Text="{Binding Token}"
                   FontSize="14"
                   VerticalContentAlignment="Center"
                   Margin="0,0,12,0"
                   ToolTip="Paste your authorization token here"/>

                    <Button Content="Submit Token"
                  Command="{Binding TokenRetrievedCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>