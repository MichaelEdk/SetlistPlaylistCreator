<UserControl x:Class="SetlistPlaylistCreator.Wpf.Playlist.Playlist"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SetlistPlaylistCreator.Wpf.Playlist"
             xmlns:designersupport="clr-namespace:SetlistPlaylistCreator.Wpf.Playlist.DesignerSupport"
             xmlns:windows="clr-namespace:SetlistPlaylistCreator.Wpf.Windows"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance designersupport:DesignTimePlaylistViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <windows:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <ContentControl>
        <ContentControl.Style>
            <Style TargetType="ContentControl" BasedOn="{StaticResource ContentControl.PageShellStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCreatingPlaylist}" Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Spotify Setlist Creator"
                       Style="{StaticResource TextBlock.PageTitleStyle}"/>

            <Button Grid.Row="1"
                    Content="{Binding CreatePlaylistButtonText}"
                    Command="{Binding CreatePlaylist}"
                    Style="{StaticResource Button.PrimaryStyle}"
                    Margin="0,0,0,16"/>

            <Border Grid.Row="2" Style="{StaticResource Border.InsetPanelCardStyle}">
                <ListView
                    ItemsSource="{Binding PlaylistRowViewModels}"
                    Style="{StaticResource ListView.BaseStyle}"
                    IsEnabled="{Binding IsCreatingPlaylist, Converter={StaticResource InverseBooleanConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Border.ListItemCardStyle}" CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Text="{Binding SelectedSong.SongName}"/>
                                        <TextBlock Style="{StaticResource TextBlock.SecondaryBodyStyle}"
                                                   Text="{Binding SelectedSong.ArtistsString}"/>
                                    </StackPanel>
                                    <Button
                                        Content="Edit"
                                        ToolTip="Select a different song from the search results"
                                        Grid.Column="1"
                                        Style="{StaticResource Button.CompactActionStyle}"
                                        Command="{Binding EditSongChoice}"
                                        CommandParameter="{Binding}">
                                    </Button>
                                    <Popup
                                        IsOpen="{Binding IsPopupVisible}"
                                        Placement="Center">
                                        <Border Style="{StaticResource Border.ListItemCardStyle}" CornerRadius="2">
                                            <ListView
                                                ItemsSource="{Binding SearchedSong.AllMatches}"
                                                Background="{DynamicResource Brush.InsetPanelBackground}"
                                                Name="SearchResultsListView">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    FontSize="14"
                                                                    Text="{Binding SongName}"
                                                                    TextWrapping="WrapWithOverflow"/>
                                                                <TextBlock
                                                                    Style="{StaticResource TextBlock.SecondaryBodyStyle}"
                                                                    Text="{Binding ArtistsString}"
                                                                    TextWrapping="WrapWithOverflow"/>
                                                            </StackPanel>
                                                            <Button
                                                                Content="Select"
                                                                Grid.Column="1"
                                                                Style="{StaticResource Button.CompactActionStyle}"
                                                                Margin="3"
                                                                Command="{Binding DataContext.SelectSongPopup, ElementName=SearchResultsListView}"
                                                                CommandParameter="{Binding}">
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </ContentControl>
</UserControl>