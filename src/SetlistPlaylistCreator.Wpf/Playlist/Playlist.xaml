<UserControl x:Class="SetlistPlaylistCreator.Wpf.Playlist.Playlist"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SetlistPlaylistCreator.Wpf.Playlist"
             xmlns:designersupport="clr-namespace:SetlistPlaylistCreator.Wpf.Playlist.DesignerSupport"
             xmlns:windows="clr-namespace:SetlistPlaylistCreator.Wpf.Windows"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance designersupport:DesignTimePlaylistViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <windows:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="AntiqueWhite"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="SetlistButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="AntiqueWhite"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F3F3">
        <Border CornerRadius="8"
            Background="White"
            Padding="24"
            Margin="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                   Text="Spotify Setlist Creator"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

                <!-- Create Playlist button -->
                <Button Grid.Row="1"
                Content="{Binding CreatePlaylistButtonText}"
                Command="{Binding CreatePlaylist}"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="0,0,0,16"/>

                <!-- Playlist display -->
                <Border Grid.Row="2"
                Background="#FAFAFA"
                CornerRadius="4"
                Padding="12">
                    <ListView
                        ItemsSource="{Binding PlaylistRowViewModels}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        IsEnabled="{Binding IsCreatingPlaylist, Converter={StaticResource InverseBooleanConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                        CornerRadius="2"
                        Padding="8"
                        Margin="0,0,0,8"
                        BorderBrush="#DDD"
                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Text="{Binding SelectedSong.SongName}"/>
                                            <TextBlock FontSize="12"
                                                       Foreground="Gray"
                                                       Text="{Binding SelectedSong.ArtistsString}"/>
                                        </StackPanel>
                                        <Button
                                            Content="Edit"
                                            ToolTip="Select a different song from the search results"
                                            Grid.Column="1"
                                            Style="{StaticResource SetlistButtonStyle}"
                                            Command="{Binding EditSongChoice}"
                                            CommandParameter="{Binding}">
                                        </Button>
                                        <Popup
                                            IsOpen="{Binding IsPopupVisible}"
                                            Placement="Center">
                                            <Border
                                                Background="White"
                                                CornerRadius="2"
                                                Padding="8"
                                                Margin="0,0,0,8"
                                                BorderBrush="#DDD"
                                                BorderThickness="1">
                                                <ListView
                                                    ItemsSource="{Binding SearchedSong.AllMatches}"
                                                    Background="#FAFAFA"
                                                    Name="SearchResultsListView">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        FontSize="14"
                                                                        Text="{Binding SongName}"
                                                                        TextWrapping="WrapWithOverflow"/>
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        Foreground="Gray"
                                                                        Text="{Binding ArtistsString}"
                                                                        TextWrapping="WrapWithOverflow"/>
                                                                </StackPanel>
                                                                <Button
                                                                    Content="Select"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource SetlistButtonStyle}"
                                                                    Margin="3"
                                                                    Command="{Binding DataContext.SelectSongPopup, ElementName=SearchResultsListView}"
                                                                    CommandParameter="{Binding}">
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>