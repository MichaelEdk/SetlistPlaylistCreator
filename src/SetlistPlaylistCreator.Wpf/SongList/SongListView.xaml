<UserControl x:Class="SetlistPlaylistCreator.Wpf.SongList.SongListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SetlistPlaylistCreator.Wpf.SongList"
             xmlns:designersupport="clr-namespace:SetlistPlaylistCreator.Wpf.SongList.DesignerSupport"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance designersupport:DesignTimeSongListViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <ContentControl Style="{StaticResource ContentControl.PageShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Spotify Setlist Creator"
                       Style="{StaticResource TextBlock.PageTitleStyle}"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,16">
                <Button Content="Search Spotify"
                        Command="{Binding SearchSpotify}"
                        Style="{StaticResource Button.PrimaryWithRightGapStyle}"/>
                <TextBlock Text="{Binding Setlist.Name}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Setlist.Sets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Border.ListItemCardStyle}" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="Bold">
                                            <Run Text="Set name: "/>
                                            <Run Text="{Binding Name}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding Songs.Count, Mode=OneWay}"/>
                                            <Run Text=" songs)"/>
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding Songs}" Margin="12,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                                                        <TextBlock Style="{StaticResource TextBlock.SecondaryBodyStyle}" Text="{Binding ArtistName}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ContentControl>
</UserControl>