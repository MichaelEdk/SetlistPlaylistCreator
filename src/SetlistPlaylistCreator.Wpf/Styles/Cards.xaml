<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DropShadowEffect x:Key="Effect.CardShadow"
                      Color="Black"
                      BlurRadius="10"
                      ShadowDepth="2"
                      Opacity="0.3"/>

    <Style x:Key="Border.PageCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.PageCardPadding}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.PageCardMargin}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{StaticResource Effect.CardShadow}"/>
    </Style>

    <Style x:Key="Border.InsetPanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.InsetPanelBackground}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="Border.ListItemCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.ListItemPadding}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.ListItemMargin}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</ResourceDictionary>
